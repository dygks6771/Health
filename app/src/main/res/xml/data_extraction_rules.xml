<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 백업·기기 이전: 로그인 토큰이 든 session 은 제외 (게임 데이터는 서버에 있음) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
